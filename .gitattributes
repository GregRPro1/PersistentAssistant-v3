*               text=auto

# Windows scripts
*.ps1           text eol=crlf
*.psm1          text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Unixy / source files
*.sh            text eol=lf
*.py            text eol=lf
*.yaml          text eol=lf
*.yml           text eol=lf
*.json          text eol=lf
*.md            text eol=lf
*.txt           text eol=lf

# Binary (no EOL conversion)
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.zip           binary
*.7z            binary
*.pdf           binary
*.exe           binary
*.dll           binary

# (Optional) stop backups from chattering
*.bak_*         -text
*.bak           -text