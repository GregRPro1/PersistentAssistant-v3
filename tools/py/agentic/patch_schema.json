{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Agentic Patch Proposal",
    "type": "object",
    "required": [
        "feature_id",
        "description",
        "changes"
    ],
    "properties": {
        "feature_id": {
            "type": "string",
            "minLength": 2
        },
        "description": {
            "type": "string"
        },
        "dry_run": {
            "type": "boolean",
            "default": true
        },
        "changes": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "path",
                    "mode"
                ],
                "properties": {
                    "path": {
                        "type": "string",
                        "minLength": 1
                    },
                    "mode": {
                        "type": "string",
                        "enum": [
                            "append",
                            "replace",
                            "patch"
                        ]
                    },
                    "expected_sha256": {
                        "type": "string",
                        "pattern": "^[0-9a-fA-F]{64}$"
                    },
                    "content": {
                        "type": "string"
                    },
                    "patch": {
                        "type": "string"
                    }
                }
            }
        },
        "meta": {
            "type": "object",
            "properties": {
                "created_utc": {
                    "type": "integer"
                },
                "author": {
                    "type": "string"
                },
                "notes": {
                    "type": "string"
                }
            }
        }
    }
}