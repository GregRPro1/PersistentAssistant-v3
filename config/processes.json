{
  "version": 1,
  "defaults": {
    "restart": {
      "policy": "always",
      "backoff": {
        "initial": 1,
        "factor": 1.5,
        "max": 60
      },
      "max_restarts": 10,
      "window": 300
    },
    "health": {
      "interval": 5,
      "timeout": 2,
      "grace": 10
    }
  },
  "processes": {
    "tunnel": {
      "name": "tunnel",
      "logs": {
        "stderr": "tmp\\logs\\cloudflared.err.log",
        "stdout": "tmp\\logs\\cloudflared.out.log"
      },
      "health": {
        "log_regex": "https?://\\S*trycloudflare\\.com",
        "publish": {
          "file": "reports\\ops\\tunnel_url.txt"
        }
      },
      "depends_on": [
        "server"
      ],
      "restart": {
        "policy": "on-failure"
      },
      "cmd": [
        "C:\\Program Files\\Cloudflare\\cloudflared\\cloudflared.exe",
        "tunnel",
        "--no-autoupdate",
        "--url",
        "http://127.0.0.1:8776"
      ]
    },
    "server": {
      "name": "server",
      "cmd": [
        "C:\\_Repos\\PersistentAssistant\\.venv\\Scripts\\python.exe",
        "-u",
        "-m",
        "server.bootstrap_mounts"
      ]
    }
  }
}
