+def _safe_read_text(p: Path) -> str:
+    try:
+        return p.read_text(encoding="utf-8", errors="ignore")
+    except Exception:
+        return ""
+
+def _annotate_parents(tree: ast.AST) -> None:
+    for parent in ast.walk(tree):
+        for child in ast.iter_child_nodes(parent):
+            setattr(child, "parent", parent)
+
+def _build_py_ast_index(files: list[Path]) -> dict:
+    """
+    Build a lightweight AST index of Python files:
+      { "<rel_path>": { "imports": [...], "classes": {"Name": ["method", ...]}, "functions": ["fname", ...] } }
+    """
+    index: dict[str, dict] = {}
+    for f in files:
+        if f.suffix.lower() != ".py":
+            continue
+        rel = str(f)
+        src = _safe_read_text(f)
+        if not src.strip():
+            continue
+        try:
+            tree = ast.parse(src, filename=rel)
+            _annotate_parents(tree)
+        except Exception as e:
+            index[rel] = {"error": f"parse_failed: {type(e).__name__}: {e}"}
+            continue
+        imports: list[str] = []
+        classes: dict[str, list[str]] = {}
+        functions: list[str] = []
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Import):
+                for n in node.names:
+                    imports.append(n.name)
+            elif isinstance(node, ast.ImportFrom):
+                mod = node.module or ""
+                for n in node.names:
+                    imports.append(f"{mod}:{n.name}")
+            elif isinstance(node, ast.ClassDef):
+                methods: list[str] = []
+                for b in node.body:
+                    if isinstance(b, ast.FunctionDef):
+                        methods.append(b.name)
+                classes[node.name] = methods
+            elif isinstance(node, ast.FunctionDef):
+                # only top-level functions (class methods handled above)
+                if isinstance(getattr(node, "parent", None), ast.Module) or not hasattr(node, "parent"):
+                    functions.append(node.name)
+        index[rel] = {
+            "imports": sorted(set(imports)),
+            "classes": {k: sorted(v) for k, v in classes.items()},
+            "functions": sorted(set(functions)),
+        }
+    return index
+
+def emit_ast_map(base_name: str, outdir: Path, files: list[Path]) -> list[Path]:
+    """
+    Create {base}_ast_index.json and {base}_ast_index.yaml in outdir.
+    Returns the created file paths.
+    """
+    py_files = [Path(p) for p in files if Path(p).suffix.lower() == ".py"]
+    ast_index = _build_py_ast_index(py_files)
+    outdir.mkdir(parents=True, exist_ok=True)
+    jpath = outdir / f"{base_name}_ast_index.json"
+    ypath = outdir / f"{base_name}_ast_index.yaml"
+    jpath.write_text(json.dumps(ast_index, indent=2), encoding="utf-8")
+    try:
+        import yaml as _yaml
+        ypath.write_text(_yaml.safe_dump(ast_index, sort_keys=False), encoding="utf-8")
+        return [jpath, ypath]
+    except Exception:
+        return [jpath]
