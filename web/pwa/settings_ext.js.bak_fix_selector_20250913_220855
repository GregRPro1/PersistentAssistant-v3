          const ul = document.createElement('ul'); ul.className='plain';
          items.forEach((s,i) => {
            const li = document.createElement('li');
            const badge = document.createElement('span'); badge.className='badge'; badge.textContent = String(i+1).padStart(2,'0');
            const txt = document.createElement('span'); txt.textContent = ' ' + (typeof s === 'string' ? s : JSON.stringify(s));
            li.append(badge, txt);
            li.addEventListener('click', () => {
              selectedStep = (typeof s === 'string') ? s : String(s);
              ul.querySelectorAll('li').forEach(n => n.classList.remove('selected'));
              li.classList.add('selected');
