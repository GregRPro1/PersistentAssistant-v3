          const summary = (function(resp){ try{ const s=(resp&&resp.run&&resp.run.stdout)||''; const lines=String(s).trim().split(/\r?\n/); for(let i=lines.length-1;i>=0;i--){const L=lines[i]; if (/\bpassed\b|\bfailed\b|\bskipped\b|\berrors?\b/i.test(L) && /(\d+\s+passed|\d+\s+failed|\d+\s+errors?|\d+\s+skipped)/i.test(L)) return L.trim(); } } catch(_){} return null; })(r.json);
