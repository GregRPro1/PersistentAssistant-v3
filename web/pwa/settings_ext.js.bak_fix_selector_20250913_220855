          try { return { ok:r.ok, status:r.status, json:JSON.parse(t), text:t }; } catch { return { ok:r.ok, status:r.status, json:null, text:t }; }
        }
        const r = await fetch(url, Object.assign({ cache:'no-store' }, opts||{})); const t = await r.text();
        try { return { ok:r.ok, status:r.status, json:JSON.parse(t), text:t }; } catch { return { ok:r.ok, status:r.status, json:null, text:t }; }
      } catch (e) {
        console.error('[ext-safety] fetch failed', e);
        return { ok:false, status:0, json:null, text:String(e||'error') };
      }
