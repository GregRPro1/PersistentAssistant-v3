{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "Agentic Patch Proposal (compat: actions|changes)",
    "type": "object",
    "required": [
        "feature_id"
    ],
    "properties": {
        "feature_id": {
            "type": "string",
            "minLength": 2
        },
        "description": {
            "type": "string"
        },
        "version": {
            "type": "integer"
        },
        "author": {
            "type": "string"
        },
        "created": {
            "type": "string"
        },
        "dry_run": {
            "type": "boolean",
            "default": true
        },
        "changes": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/changeItem"
            }
        },
        "actions": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/changeItem"
            }
        },
        "meta": {
            "type": "object",
            "properties": {
                "created_utc": {
                    "type": "integer"
                },
                "notes": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        }
    },
    "allOf": [
        {
            "anyOf": [
                {
                    "required": [
                        "changes"
                    ]
                },
                {
                    "required": [
                        "actions"
                    ]
                }
            ]
        }
    ],
    "$defs": {
        "changeItem": {
            "type": "object",
            "required": [
                "path",
                "mode"
            ],
            "properties": {
                "path": {
                    "type": "string",
                    "minLength": 1
                },
                "mode": {
                    "type": "string",
                    "enum": [
                        "append",
                        "replace",
                        "patch"
                    ]
                },
                "expected_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{64}$"
                },
                "before_sha": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{64}$",
                    "description": "alias of expected_sha256 (back-compat)"
                },
                "content": {
                    "type": "string"
                },
                "patch": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        }
    },
    "additionalProperties": true
}